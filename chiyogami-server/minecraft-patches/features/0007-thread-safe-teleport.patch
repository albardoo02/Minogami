+        };
+        return this.level().worldThread.runWorldTaskThreadSafely(newLevel.worldThread, new world.chiyogami.thread.WorldTask<>(teleportTask), "NMS Entity teleport");
+        // Chiyogami end
     }
 
     protected void teleportSpectators(final TeleportTransition transition, final ServerLevel oldLevel) {
