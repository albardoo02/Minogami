diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index 5cc94652112c67ca4e7ae6e8b324e9c9f8908d7d..e1ad645eee75f1bb3e874d17fc38e15e5f9baa15 100644
