From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bea4dev <bea0224@outlook.jp>
Date: Tue, 29 Apr 2025 01:33:00 +0900
Subject: [PATCH] add world threading


diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index 68151ce05e7009f28dda0470c744920cbd5f4a27..d17fd6a3b39f12c4f178e824c32aedb5bb277bf4 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -1813,6 +1813,12 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
 
         this.isIteratingOverLevels = true; // Paper - Throw exception on world create while being ticked
         for (ServerLevel level : this.getAllLevels()) {
+            // Chiyogami start - world threading
+            world.chiyogami.thread.WorldThread worldThread = level.worldThread;
+            if (worldThread.getWorldTickRunnable() == null) {
+            worldThread.setWorldTickRunnable(() -> {
+            level.thread = Thread.currentThread();
+            // Chiyogami end
             level.hasPhysicsEvent = org.bukkit.event.block.BlockPhysicsEvent.getHandlerList().getRegisteredListeners().length > 0; // Paper - BlockPhysicsEvent
             level.hasEntityMoveEvent = io.papermc.paper.event.entity.EntityMoveEvent.getHandlerList().getRegisteredListeners().length > 0; // Paper - Add EntityMoveEvent
             level.updateLagCompensationTick(); // Paper - lag compensation
@@ -1831,7 +1837,9 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
             profiler.pop();
             profiler.pop();
             level.explosionDensityCache.clear(); // Paper - Optimize explosions
+            });} // Chiyogami - world threading
         }
+        world.chiyogami.thread.WorldThreadPool.doTick(this.levels.values()); // Chiyogami - world threading
         this.isIteratingOverLevels = false; // Paper - Throw exception on world create while being ticked
 
         profiler.popPush("connection");
diff --git a/net/minecraft/world/level/Level.java b/net/minecraft/world/level/Level.java
index 9286d9bcf3ec4069e77d3133f3d7bf29b2370c5a..914e19c0c70239547629b103b5c1320c5a17ceb6 100644
--- a/net/minecraft/world/level/Level.java
+++ b/net/minecraft/world/level/Level.java
@@ -101,6 +101,7 @@ import org.bukkit.craftbukkit.CraftWorld;
 import org.bukkit.craftbukkit.block.CraftBlockState;
 import org.bukkit.craftbukkit.block.data.CraftBlockData;
 import org.bukkit.entity.SpawnCategory;
+import world.chiyogami.thread.WorldThread;
 // CraftBukkit end
 
 public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemLevel, ca.spottedleaf.moonrise.patches.chunk_system.world.ChunkSystemEntityGetter { // Paper - rewrite chunk system // Paper - optimise collisions
@@ -123,7 +124,10 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
     protected final CollectingNeighborUpdater neighborUpdater;
     private final List<TickingBlockEntity> pendingBlockEntityTickers = Lists.newArrayList();
     private boolean tickingBlockEntities;
-    protected final Thread thread;
+    // Chiyogami start - world threading
+    public Thread thread;
+    public WorldThread worldThread;
+    // Chiyogami end
     private final boolean isDebug;
     private int skyDarken;
     protected int randValue = RandomSource.createThreadLocalInstance().nextInt();
