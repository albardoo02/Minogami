+package world.chiyogami.log;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.AtomicInteger;
+
+public final class SafeguardLogger {
+    private static final Logger LOGGER = LoggerFactory.getLogger("Minogami-Safeguard");
+    private static final long RATE_LIMIT_WINDOW_MS = 5000L;
+
+    private static class RateLimitEntry {
+        long lastLogTime;
+        final AtomicInteger count = new AtomicInteger(0);
+
+        RateLimitEntry(long now) {
+            this.lastLogTime = now;
+        }
+    }
+
+    private static final ConcurrentHashMap<String, RateLimitEntry> rateLimitMap = new ConcurrentHashMap<>();
+
+    private SafeguardLogger() {}
+
+    private static String getExceptionSignature(String context, Throwable t) {
+        StringBuilder sb = new StringBuilder();
+        sb.append(context).append(':').append(t.getClass().getName());
+        StackTraceElement[] trace = t.getStackTrace();
+        if (trace != null && trace.length > 0) {
+            StackTraceElement top = trace[0];
+            sb.append('@').append(top.getClassName()).append('.').append(top.getMethodName()).append(':').append(top.getLineNumber());
+        }
+        return sb.toString();
+    }
+
+    public static void logSafeguardException(String context, Throwable t) {
+        long now = System.currentTimeMillis();
+        String sig = getExceptionSignature(context, t);
+
+        RateLimitEntry entry = rateLimitMap.compute(sig, (k, existing) -> {
+            if (existing == null) {
+                return new RateLimitEntry(now);
+            }
+            return existing;
+        });
+
+        int currentCount = entry.count.incrementAndGet();
+        synchronized (entry) {
+            if (now - entry.lastLogTime >= RATE_LIMIT_WINDOW_MS) {
+                long suppressed = currentCount - 1;
+                entry.count.set(0);
+                entry.lastLogTime = now;
+                if (suppressed > 0) {
+                    LOGGER.error("[Minogami-Safeguard] Caught exception in {} (suppressed {} identical occurrences in last {}s): {}",
+                            context, suppressed, RATE_LIMIT_WINDOW_MS / 1000, t.getMessage(), t);
+                } else {
+                    LOGGER.error("[Minogami-Safeguard] Caught exception in {}: {}", context, t.getMessage(), t);
+                }
+            } else if (currentCount == 1) {
+                LOGGER.error("[Minogami-Safeguard] Caught exception in {}: {}", context, t.getMessage(), t);
+            }
+        }
+    }
+}
