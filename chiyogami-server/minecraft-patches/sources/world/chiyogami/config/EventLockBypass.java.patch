+package world.chiyogami.config;
+
+import java.util.*;
+import java.util.concurrent.ConcurrentHashMap;
+
+public final class EventLockBypass {
+    private static volatile Set<String> bypassEventNames = Collections.emptySet();
+    private static final Set<Class<?>> bypassEventClasses = Collections.newSetFromMap(new ConcurrentHashMap<>());
+    private static volatile List<String> bypassPluginPrefixes = Collections.emptyList();
+    private static final Map<String, Boolean> pluginBypassCache = new ConcurrentHashMap<>();
+
+    private EventLockBypass() {}
+
+    public static void setConfig(List<String> events, List<String> plugins) {
+        bypassEventNames = new HashSet<>(events != null ? events : Collections.emptyList());
+        bypassEventClasses.clear();
+        bypassPluginPrefixes = new ArrayList<>(plugins != null ? plugins : Collections.emptyList());
+        pluginBypassCache.clear();
+    }
+
+    public static boolean isEventBypassed(Class<?> eventClass) {
+        if (bypassEventNames.isEmpty() || eventClass == null) {
+            return false;
+        }
+        if (bypassEventClasses.contains(eventClass)) {
+            return true;
+        }
+        String name = eventClass.getName();
+        if (bypassEventNames.contains(name)) {
+            bypassEventClasses.add(eventClass);
+            return true;
+        }
+        return false;
+    }
+
+    public static boolean isPluginBypassed(String pluginName) {
+        if (pluginName == null || bypassPluginPrefixes.isEmpty()) {
+            return false;
+        }
+        Boolean cached = pluginBypassCache.get(pluginName);
+        if (cached != null) {
+            return cached;
+        }
+        boolean matched = false;
+        for (String prefix : bypassPluginPrefixes) {
+            if (pluginName.startsWith(prefix) || pluginName.equalsIgnoreCase(prefix)) {
+                matched = true;
+                break;
+            }
+        }
+        pluginBypassCache.put(pluginName, matched);
+        return matched;
+    }
+}
