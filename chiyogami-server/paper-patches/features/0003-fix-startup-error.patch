From: bea4dev <bea0224@outlook.jp>
Date: Tue, 29 Apr 2025 17:03:13 +0900
Subject: [PATCH] fix startup error


diff --git a/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java b/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java
index 51731a2bf4659dd7f3d74fa73cb8d9e5e9d08770..94a1a94b465674175c895b7838496876a9d4a602 100644
--- a/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java
+++ b/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java
@@ -28,6 +28,7 @@ import java.util.logging.Level;
 
 public class PaperEventManager {
     public static boolean synchronizedEvent; // Chiyogami - config
+    private final java.util.concurrent.locks.ReentrantLock EVENT_LOCK = new world.chiyogami.thread.WorldThreadSafeLock(true); // Chiyogami - synced event
 
     private final Server server;
 
@@ -35,8 +36,22 @@ public class PaperEventManager {
         this.server = server;
     }
 
+    // Chiyogami start - synced event
     // SimplePluginManager
     public void callEvent(@NotNull Event event) {
+        boolean shouldSync = synchronizedEvent && !event.isAsynchronous();
+        if (shouldSync) {
+            EVENT_LOCK.lock();
+            try {
+                callEventInternal(event);
+            } finally {
+                EVENT_LOCK.unlock();
+            }
+        } else {
+            callEventInternal(event);
+        }
+    }
+    void callEventInternal(@NotNull Event event) {
         if (event.isAsynchronous() && this.server.isPrimaryThread()) {
             throw new IllegalStateException(event.getEventName() + " may only be triggered asynchronously.");
         } else if (!event.isAsynchronous() && !this.server.isPrimaryThread() && !this.server.isStopping()) {
diff --git a/src/main/java/org/bukkit/craftbukkit/CraftServer.java b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
index 83b8d44c7c8fc3cabb371c4e6ab9e1a9320ead35..60aed0b379897860d9703663d7aef199f780347c 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftServer.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
@@ -405,6 +405,7 @@ public final class CraftServer implements Server {
         this.serverLinks = new CraftServerLinks(console);
 
         Bukkit.setServer(this);
+        world.chiyogami.thread.ChiyogamiServerThreadProvider.init(); // Chiyogami - add ChiyogamiLib
         // Paper start
         this.commandMap = new CraftCommandMap(this);
         this.pluginManager = new SimplePluginManager(this, commandMap);
