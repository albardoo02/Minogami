index 0000000000000000000000000000000000000000..790f27d323c48309e3e12009a17e7c32900a909c
--- /dev/null
+++ b/world/minogami/thread/ImplWorldTickScheduler.java
@@ -0,0 +1,291 @@
+package world.minogami.thread;
+
+import net.minecraft.server.MinecraftServer;
+import org.bukkit.Bukkit;
+import org.bukkit.World;
+import org.bukkit.craftbukkit.CraftWorld;
+import org.bukkit.plugin.Plugin;
+import world.minogami.log.SafeguardLogger;
+
+import java.util.List;
+import java.util.Objects;
+import java.util.Set;
+import java.util.concurrent.CancellationException;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.function.Supplier;
+
+/**
+ * Server-side implementation of {@link WorldTickScheduler}.
+ * <p>
+ * Loaded lazily by {@link WorldTickScheduler} through reflection, so no bootstrap code
+ * in {@code net.minecraft} is required.
+ *
+ * <h2>Lifecycle</h2>
+ * Every {@link WorldThread} that has ever received a hook or a handoff is tracked. After each server tick,
+ * {@link #sweep()} (main thread, no world is ticking) closes the tracked worlds that are no longer loaded:
+ * their hooks are cancelled and their pending handoffs fail. Producers re-check the closed flag after
+ * enqueueing, so an entry added concurrently with closing is never left behind.
+ */
+public final class ImplWorldTickScheduler extends WorldTickScheduler {
+
+    private static final Set<WorldThread> TRACKED = ConcurrentHashMap.newKeySet();
+
+    public ImplWorldTickScheduler() {super();}
+
+    // ------------------------------------------------------------------
+    // Entries
+    // ------------------------------------------------------------------
+
+    static final class HookEntry implements WorldTickHook {
+        private final Plugin plugin;
+        private final World world;
+        private final TickPhase phase;
+        private final Runnable task;
+        private final WorldThread owner;
+        private volatile boolean cancelled = false;
+
+        HookEntry(Plugin plugin, World world, TickPhase phase, Runnable task, WorldThread owner) {
+            this.plugin = plugin;
+            this.world = world;
+            this.phase = phase;
+            this.task = task;
+            this.owner = owner;
+        }
+
+        @Override public Plugin getPlugin() {return plugin;}
+        @Override public World getWorld() {return world;}
+        @Override public TickPhase getPhase() {return phase;}
+        @Override public boolean isCancelled() {return cancelled;}
+
+        @Override
+        public void cancel() {
+            cancelled = true;
+            hooksOf(owner, phase).remove(this);
+        }
+    }
+
+    static final class HandoffEntry {
+        private final Plugin plugin;
+        private final Supplier<?> supplier;
+        private final CompletableFuture<Object> future;
+
+        @SuppressWarnings("unchecked")
+        HandoffEntry(Plugin plugin, Supplier<?> supplier, CompletableFuture<?> future) {
+            this.plugin = plugin;
+            this.supplier = supplier;
+            this.future = (CompletableFuture<Object>) future;
+        }
+    }
+
+    // ------------------------------------------------------------------
+    // Called from WorldThread#run (on the world thread)
+    // ------------------------------------------------------------------
+
+    static void runHooks(WorldThread worldThread, List<HookEntry> hooks) {
+        if (hooks.isEmpty()) return;
+        for (HookEntry hook : hooks) { // CopyOnWriteArrayList: safe against cancel()/register during iteration
+            if (hook.cancelled) continue;
+            if (!hook.plugin.isEnabled()) {
+                hook.cancel();
+                continue;
+            }
+            try {
+                hook.task.run();
+            } catch (Throwable t) {
+                rethrowIfFatal(t);
+                SafeguardLogger.logSafeguardException("WorldTickHook[" + hook.plugin.getName() + "] at " + worldName(worldThread), t);
+            }
+        }
+    }
+
+    static void runHandoffs(WorldThread worldThread) {
+        if (worldThread.handoffQueue.isEmpty()) return;
+        // Only drain what was queued before this tick started; entries added while draining run next tick.
+        int count = worldThread.handoffQueue.size();
+        HandoffEntry entry;
+        while (count-- > 0 && (entry = worldThread.handoffQueue.poll()) != null) {
+            if (entry.future.isDone()) continue; // cancelled by the caller
+            if (!entry.plugin.isEnabled()) {
+                entry.future.completeExceptionally(new IllegalStateException("Plugin " + entry.plugin.getName() + " is disabled"));
+                continue;
+            }
+            Object result;
+            try {
+                result = entry.supplier.get();
+            } catch (Throwable t) {
+                rethrowIfFatal(t);
+                entry.future.completeExceptionally(t);
+                SafeguardLogger.logSafeguardException("WorldHandoff[" + entry.plugin.getName() + "] at " + worldName(worldThread), t);
+                continue;
+            }
+            // Dependent stages of the future (thenAccept …) run here, on this world thread.
+            try {
+                entry.future.complete(result);
+            } catch (Throwable t) {
+                rethrowIfFatal(t);
+                SafeguardLogger.logSafeguardException("WorldHandoff[" + entry.plugin.getName() + "] callback at " + worldName(worldThread), t);
+            }
+        }
+    }
+
+    // ------------------------------------------------------------------
+    // Called from WorldThreadPool (main thread, between ticks)
+    // ------------------------------------------------------------------
+
+    static void sweep() {
+        if (TRACKED.isEmpty()) return;
+        for (WorldThread worldThread : TRACKED) {
+            if (!isLoaded(worldThread)) {
+                close(worldThread, "World " + worldName(worldThread) + " was unloaded");
+            } else {
+                // Release hooks of plugins disabled while their world did not tick.
+                removeDisabledHooks(worldThread.preTickHooks);
+                removeDisabledHooks(worldThread.postTickHooks);
+            }
+        }
+    }
+
+    static void closeAll(String reason) {
+        for (WorldThread worldThread : TRACKED) {
+            close(worldThread, reason);
+        }
+    }
+
+    private static void close(WorldThread worldThread, String reason) {
+        worldThread.tickApiClosed = true;
+        TRACKED.remove(worldThread);
+        for (HookEntry hook : worldThread.preTickHooks) hook.cancelled = true;
+        for (HookEntry hook : worldThread.postTickHooks) hook.cancelled = true;
+        worldThread.preTickHooks.clear();
+        worldThread.postTickHooks.clear();
+        failPendingHandoffs(worldThread, reason);
+    }
+
+    private static void failPendingHandoffs(WorldThread worldThread, String reason) {
+        HandoffEntry entry;
+        while ((entry = worldThread.handoffQueue.poll()) != null) {
+            try {
+                entry.future.completeExceptionally(new CancellationException(reason));
+            } catch (Throwable t) {
+                rethrowIfFatal(t);
+                SafeguardLogger.logSafeguardException("WorldHandoff[" + entry.plugin.getName() + "] callback (closed)", t);
+            }
+        }
+    }
+
+    private static void removeDisabledHooks(List<HookEntry> hooks) {
+        if (hooks.isEmpty()) return;
+        for (HookEntry hook : hooks) {
+            if (!hook.plugin.isEnabled()) hook.cancel();
+        }
+    }
+
+    // ------------------------------------------------------------------
+    // API implementation
+    // ------------------------------------------------------------------
+
+    @Override
+    protected WorldTickHook registerTickHookImpl(Plugin plugin, World world, TickPhase phase, Runnable task) {
+        Objects.requireNonNull(plugin, "plugin");
+        Objects.requireNonNull(world, "world");
+        Objects.requireNonNull(phase, "phase");
+        Objects.requireNonNull(task, "task");
+        if (!plugin.isEnabled()) {
+            throw new IllegalStateException("Plugin " + plugin.getName() + " is disabled");
+        }
+        WorldThread worldThread = worldThreadOf(world);
+        if (worldThread.tickApiClosed) {
+            throw new IllegalStateException("World " + world.getName() + " is unloaded");
+        }
+        TRACKED.add(worldThread);
+        HookEntry entry = new HookEntry(plugin, world, phase, task, worldThread);
+        hooksOf(worldThread, phase).add(entry);
+        // Re-check after publishing: the world may have been closed concurrently.
+        if (worldThread.tickApiClosed) {
+            entry.cancel();
+            throw new IllegalStateException("World " + world.getName() + " is unloaded");
+        }
+        return entry;
+    }
+
+    @Override
+    protected <T> CompletableFuture<T> handoffImpl(Plugin plugin, World world, Supplier<T> task) {
+        Objects.requireNonNull(plugin, "plugin");
+        Objects.requireNonNull(world, "world");
+        Objects.requireNonNull(task, "task");
+        CompletableFuture<T> future = new CompletableFuture<>();
+        if (!plugin.isEnabled()) {
+            future.completeExceptionally(new IllegalStateException("Plugin " + plugin.getName() + " is disabled"));
+            return future;
+        }
+        MinecraftServer server = MinecraftServer.getServer();
+        if (server == null || !server.isRunning() || Bukkit.isStopping()) {
+            future.completeExceptionally(new IllegalStateException("Server is stopping"));
+            return future;
+        }
+        WorldThread worldThread = worldThreadOf(world);
+        if (worldThread.tickApiClosed) {
+            future.completeExceptionally(new IllegalStateException("World " + world.getName() + " is unloaded"));
+            return future;
+        }
+        TRACKED.add(worldThread);
+        worldThread.handoffQueue.offer(new HandoffEntry(plugin, task, future));
+        // Re-check after publishing: if the world was closed concurrently, nobody else will drain the queue.
+        if (worldThread.tickApiClosed) {
+            failPendingHandoffs(worldThread, "World " + world.getName() + " is unloaded");
+        }
+        return future;
+    }
+
+    @Override
+    protected boolean isWorldThreadImpl(World world) {
+        if (!(world instanceof CraftWorld craftWorld)) return false;
+        var handle = craftWorld.getHandle();
+        if (handle == null || handle.worldThread == null) return false;
+        return WorldThreadPool.getWorldThreadFromCurrentThread() == handle.worldThread;
+    }
+
+    @Override
+    protected long getWorldTickImpl(World world) {
+        return worldThreadOf(world).getTick();
+    }
+
+    // ------------------------------------------------------------------
+
+    private static List<HookEntry> hooksOf(WorldThread worldThread, TickPhase phase) {
+        return phase == TickPhase.PRE ? worldThread.preTickHooks : worldThread.postTickHooks;
+    }
+
+    private static WorldThread worldThreadOf(World world) {
+        if (!(world instanceof CraftWorld craftWorld)) {
+            throw new IllegalArgumentException("Not a server world: " + world);
+        }
+        var handle = craftWorld.getHandle();
+        if (handle == null || handle.worldThread == null) {
+            throw new IllegalStateException("World " + world.getName() + " is not initialized or unloaded");
+        }
+        return handle.worldThread;
+    }
+
+    private static boolean isLoaded(WorldThread worldThread) {
+        World world = worldThread.getLevel().getWorld();
+        return world != null && Bukkit.getWorld(world.getUID()) == world;
+    }
+
+    private static String worldName(WorldThread worldThread) {
+        World world = worldThread.getLevel().getWorld();
+        return world != null ? world.getName() : "world";
+    }
+
+    /**
+     * Never swallow errors the JVM cannot recover from (OutOfMemoryError, InternalError …).
+     * StackOverflowError is a VirtualMachineError too but is recoverable once the stack unwinds, so it is logged.
+     * LinkageError (e.g. NoClassDefFoundError from a plugin being reloaded) is plugin-local and logged as well.
+     */
+    private static void rethrowIfFatal(Throwable t) {
+        if (t instanceof VirtualMachineError && !(t instanceof StackOverflowError)) {
+            throw (VirtualMachineError) t;
+        }
+    }
+}
