@@ -501,6 +501,7 @@ public abstract class PlayerList {
         player.retireScheduler(); // Paper - Folia schedulers
         player.getAdvancements().clearTriggers();
         this.players.remove(player);
+        world.minogami.bridge.ParallelBridge.removeParallelEntityMoveHandler(player.getBukkitEntity()); // Minogami - clean up move handler on disconnect
         this.playersByName.remove(player.getScoreboardName().toLowerCase(java.util.Locale.ROOT)); // Spigot
         this.server.getCustomBossEvents().onPlayerDisconnect(player);
         UUID uuid = player.getUUID();
diff --git a/world/minogami/config/EventLockBypass.java b/world/minogami/config/EventLockBypass.java
index 8538297764dfae603f66714311547ea0949b3d72..dedc1a91178c2500bf9f07beeee8716d77601337 100644
--- a/world/minogami/config/EventLockBypass.java
+++ b/world/minogami/config/EventLockBypass.java
@@ -25,30 +25,40 @@ public final class EventLockBypass {
         if (eventClass == null || bypassedEventClasses.isEmpty()) {
             return false;
         }
-        return eventClassCache.computeIfAbsent(eventClass, clazz -> {
-            Class<?> current = clazz;
-            while (current != null && current != Object.class) {
-                if (bypassedEventClasses.contains(current.getName())) {
-                    return true;
-                }
-                current = current.getSuperclass();
+        Boolean cached = eventClassCache.get(eventClass);
+        if (cached != null) {
+            return cached;
+        }
+        boolean bypassed = false;
+        Class<?> current = eventClass;
+        while (current != null && current != Object.class) {
+            if (bypassedEventClasses.contains(current.getName())) {
+                bypassed = true;
+                break;
             }
-            return false;
-        });
+            current = current.getSuperclass();
+        }
+        eventClassCache.put(eventClass, bypassed);
+        return bypassed;
     }
 
     public static boolean isPluginBypassed(String pluginName) {
         if (pluginName == null || bypassedPluginPrefixes.isEmpty()) {
             return false;
         }
-        return pluginNameCache.computeIfAbsent(pluginName, name -> {
-            for (String prefix : bypassedPluginPrefixes) {
-                int prefixLen = prefix.length();
-                if (prefixLen <= name.length() && name.regionMatches(true, 0, prefix, 0, prefixLen)) {
-                    return true;
-                }
+        Boolean cached = pluginNameCache.get(pluginName);
+        if (cached != null) {
+            return cached;
+        }
+        boolean bypassed = false;
+        for (String prefix : bypassedPluginPrefixes) {
+            int prefixLen = prefix.length();
+            if (prefixLen <= pluginName.length() && pluginName.regionMatches(true, 0, prefix, 0, prefixLen)) {
+                bypassed = true;
+                break;
             }
-            return false;
-        });
+        }
+        pluginNameCache.put(pluginName, bypassed);
+        return bypassed;
     }
 }
