From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: albardoo02 <akshs@outlook.jp>
Date: Tue, 20 Oct 2026 17:19:45 +0900
Subject: [PATCH] perf(core): dynamic haveTime propagation, zero-alloc bypass
 caches, fast-path tasks, and player disconnect cleanup


diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index 028943e628658f05fb12005e81cdb26dcdf0f35b..2cfad701448706b1a0ef30c01a4b45b6b0343cb7 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -1800,12 +1800,13 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         for (ServerLevel level : this.getAllLevels()) {
             // Minogami start - world threading
             world.minogami.thread.WorldThread worldThread = level.worldThread;
+            worldThread.setHaveTime(haveTime); // Minogami - update dynamic haveTime for this tick
             if (worldThread.getWorldTickRunnable() == null) {
             worldThread.setWorldTickRunnable(() -> {
             level.thread = Thread.currentThread();
             // Minogami end
             // Minogami start - add ChiyogamiLib
-            world.chiyogami.chiyogamilib.scheduler.WorldThreadRunnable.worldThreadHeartBeat(level.getWorld(), currentTick);
+            world.chiyogami.chiyogamilib.scheduler.WorldThreadRunnable.worldThreadHeartBeat(level.getWorld(), MinecraftServer.currentTick);
             long worldServerStartTimeNano = System.nanoTime();
             // Minogami end
             level.hasPhysicsEvent = org.bukkit.event.block.BlockPhysicsEvent.getHandlerList().getRegisteredListeners().length > 0; // Paper - BlockPhysicsEvent
@@ -1816,7 +1817,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
             profiler.push("tick");
 
             try {
-                level.tick(haveTime);
+                level.tick(worldThread.getHaveTime());
             } catch (Throwable t) {
                 CrashReport report = CrashReport.forThrowable(t, "Exception ticking world");
                 level.fillReportDetails(report);
diff --git a/net/minecraft/server/players/PlayerList.java b/net/minecraft/server/players/PlayerList.java
index 62f57eb254321902692550d0a86c24292ef9e87d..ae8c3c5eb42262340a01e2927c8c0a3b83597e54 100644
--- a/net/minecraft/server/players/PlayerList.java
