diff --git a/world/minogami/config/EventLockBypass.java b/world/minogami/config/EventLockBypass.java
new file mode 100644
index 0000000000000000000000000000000000000000..73c3b398b2dc3916b32db7c58c6e8059e09503d1
--- /dev/null
+++ b/world/minogami/config/EventLockBypass.java
@@ -0,0 +1,49 @@
+package world.minogami.config;
+
+import java.util.*;
+import java.util.concurrent.ConcurrentHashMap;
+
+public final class EventLockBypass {
+    private static volatile Set<String> bypassedEventClasses = Collections.emptySet();
+    private static volatile List<String> bypassedPluginPrefixes = Collections.emptyList();
+
+    private static final Map<Class<?>, Boolean> eventClassCache = new ConcurrentHashMap<>();
+    private static final Map<String, Boolean> pluginNameCache = new ConcurrentHashMap<>();
+
+    public static void setConfig(List<String> eventClasses, List<String> pluginPrefixes) {
+        bypassedEventClasses = new HashSet<>(eventClasses != null ? eventClasses : Collections.emptyList());
+        bypassedPluginPrefixes = new ArrayList<>(pluginPrefixes != null ? pluginPrefixes : Collections.emptyList());
+        eventClassCache.clear();
+        pluginNameCache.clear();
+    }
+
+    public static boolean isEventBypassed(Class<?> eventClass) {
+        if (eventClass == null || bypassedEventClasses.isEmpty()) {
+            return false;
+        }
+        return eventClassCache.computeIfAbsent(eventClass, clazz -> {
+            Class<?> current = clazz;
+            while (current != null && current != Object.class) {
+                if (bypassedEventClasses.contains(current.getName())) {
+                    return true;
+                }
+                current = current.getSuperclass();
+            }
+            return false;
+        });
+    }
+
+    public static boolean isPluginBypassed(String pluginName) {
+        if (pluginName == null || bypassedPluginPrefixes.isEmpty()) {
+            return false;
+        }
+        return pluginNameCache.computeIfAbsent(pluginName, name -> {
+            for (String prefix : bypassedPluginPrefixes) {
+                if (name.equalsIgnoreCase(prefix) || name.startsWith(prefix)) {
+                    return true;
+                }
+            }
+            return false;
+        });
+    }
+}
