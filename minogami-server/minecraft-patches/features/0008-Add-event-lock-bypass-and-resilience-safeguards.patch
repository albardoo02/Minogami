+    public void executeWorldTasks() {
+        List<WorldTask<?>> tasksToRun = null;
+        try {
+            LOCK.lock();
+            if (worldTasks.isEmpty()) return;
+            tasksToRun = new ArrayList<>(worldTasks);
+            worldTasks.clear();
+        } finally {
+            LOCK.unlock();
+        }
+        if (tasksToRun != null) {
+            for (WorldTask<?> task : tasksToRun) {
+                try {
+                    task.complete();
+                } catch (Throwable t) {
+                    world.minogami.log.SafeguardLogger.logSafeguardException("WorldTask completion", t);
+                }
+            }
+        }
