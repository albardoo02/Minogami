From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bea4dev <bea0224@outlook.jp>
Date: Tue, 29 Apr 2025 14:31:41 +0900
Subject: [PATCH] add ChiyogamiLib


diff --git a/net/minecraft/server/Main.java b/net/minecraft/server/Main.java
index aa7f2ba4d931f98ce15c52dc2b99f07504149582..5c6af788224fa259129956f1f6e86f1f98c6f962 100644
--- a/net/minecraft/server/Main.java
+++ b/net/minecraft/server/Main.java
@@ -68,6 +68,7 @@ public class Main {
     @SuppressForbidden(reason = "System.out needed before bootstrap")
     public static void main(final OptionSet options) { // CraftBukkit - replaces main(String[] args)
         io.papermc.paper.log.LogManagerShutdownThread.hook(); // Paper - Improved watchdog support
+        world.minogami.thread.MinogamiServerThreadProvider.init(); // Minogami - add ChiyogamiLib
         SharedConstants.tryDetectVersion();
         /* CraftBukkit start - Replace everything
         OptionParser parser = new OptionParser();
diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index d70d1af02ea1536e87f9192fba0d158dddfc3daf..9c5ae2b9cc1b0635db35676d61cb4c862cb4ddcf 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -457,6 +457,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
 
     @Override
     public final void moonrise$executeMidTickTasks() {
+        if (!world.chiyogami.chiyogamilib.ChiyogamiLib.isMainThread()) { return; } // Minogami - add ChiyogamiLib
         final long startTime = System.nanoTime();
         if ((startTime - this.lastMidTickExecute) <= CHUNK_TASK_QUEUE_BACKOFF_MIN_TIME || (startTime - this.lastMidTickExecuteFailure) <= TASK_EXECUTION_FAILURE_BACKOFF) {
             // it's shown to be bad to constantly hit the queue (chunk loads slow to a crawl), even if no tasks are executed.
@@ -1649,6 +1650,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         this.smoothedTickTimeMillis = this.smoothedTickTimeMillis * 0.8F + (float)tickTime / (float)TimeUtil.NANOSECONDS_PER_MILLISECOND * 0.19999999F;
         this.logTickMethodTime(nano);
         profiler.pop();
+        world.chiyogami.chiyogamilib.monitor.PerformanceMonitor.setFullServerTickNanoTime(System.nanoTime() - nano); // Minogami - add ChiyogamiLib
     }
 
     protected void processPacketsAndTick(final boolean sprinting) {
@@ -1793,6 +1795,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         this.updateEffectiveRespawnData();
 
         this.isIteratingOverLevels = true; // Paper - Throw exception on world create while being ticked
+        long allWorldServerStartTimeNano = System.nanoTime(); // Minogami - add ChiyogamiLib
         for (ServerLevel level : this.getAllLevels()) {
             // Minogami start - world threading
             world.minogami.thread.WorldThread worldThread = level.worldThread;
@@ -1800,6 +1803,10 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
             worldThread.setWorldTickRunnable(() -> {
             level.thread = Thread.currentThread();
             // Minogami end
+            // Minogami start - add ChiyogamiLib
+            world.chiyogami.chiyogamilib.scheduler.WorldThreadRunnable.worldThreadHeartBeat(level.getWorld(), currentTick);
+            long worldServerStartTimeNano = System.nanoTime();
+            // Minogami end
             level.hasPhysicsEvent = org.bukkit.event.block.BlockPhysicsEvent.getHandlerList().getRegisteredListeners().length > 0; // Paper - BlockPhysicsEvent
             level.hasEntityMoveEvent = io.papermc.paper.event.entity.EntityMoveEvent.getHandlerList().getRegisteredListeners().length > 0; // Paper - Add EntityMoveEvent
             level.updateLagCompensationTick(); // Paper - lag compensation
@@ -1818,6 +1825,9 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
             profiler.pop();
             profiler.pop();
             level.explosionDensityCache.clear(); // Paper - Optimize explosions
+            // Minogami start - add ChiyogamiLib
+            world.chiyogami.chiyogamilib.monitor.PerformanceMonitor.getWorldTickNanoTimeMap().put(level.getWorld().getName(), System.nanoTime() - worldServerStartTimeNano);
+            // Minogami end
             });} // Minogami - world threading
         }
         world.minogami.thread.WorldThreadPool.doTick(this.levels.values()); // Minogami - world threading
diff --git a/world/minogami/thread/ImplConcurrentTaskHandler.java b/world/minogami/thread/ImplConcurrentTaskHandler.java
index 39b8c55b4aa4564639d005003b4929c648e09af1..2b29514aa0a9bf02b70a7960e126007ff096898d 100644
--- a/world/minogami/thread/ImplConcurrentTaskHandler.java
+++ b/world/minogami/thread/ImplConcurrentTaskHandler.java
@@ -3,6 +3,7 @@ package world.minogami.thread;
 import org.bukkit.Bukkit;
 import org.bukkit.World;
 import org.bukkit.craftbukkit.CraftWorld;
+import world.chiyogami.chiyogamilib.ChiyogamiLib;
 
 import java.util.concurrent.ExecutionException;
 import java.util.function.Supplier;
@@ -14,7 +15,7 @@ public class ImplConcurrentTaskHandler extends ConcurrentTaskHandler {
     @Override
     protected <T> T runConcurrentTaskForWorldImpl(World targetWorld, Supplier<T> supplier) {
         // Main thread
-        if (Bukkit.isMainThread()) {
+        if (ChiyogamiLib.isMainThread()) {
             return supplier.get();
         }
         
diff --git a/world/minogami/thread/ImplWorldThreadLockHandler.java b/world/minogami/thread/ImplWorldThreadLockHandler.java
index 6c898f7abcb3658463cef092f350661287cbec87..ecb23fb0899af69240aca7773a956bbaf2d67bce 100644
--- a/world/minogami/thread/ImplWorldThreadLockHandler.java
