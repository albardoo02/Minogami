--- a/world/minogami/thread/WorldThreadPool.java
+++ b/world/minogami/thread/WorldThreadPool.java
@@ -28,6 +28,11 @@ public class WorldThreadPool {
         worldThreadHashMap.put(Thread.currentThread(), worldThread);
     }
 
+    public static void clearCurrentWorldThread() {
+        CURRENT_WORLD_THREAD.remove();
+        worldThreadHashMap.remove(Thread.currentThread());
+    }
+
     public static void addCurrentThreadToWorldThreadHashMap(WorldThread worldThread) {
         setCurrentWorldThread(worldThread);
     }
@@ -76,7 +81,12 @@ public class WorldThreadPool {
         for (int i = 0; i < futures.size(); i++) {
             try {
                 futures.get(i).get();
-            } catch (Exception e){e.printStackTrace();}
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+                e.printStackTrace();
+            } catch (Exception e) {
+                e.printStackTrace();
+            }
         }
     }
     
