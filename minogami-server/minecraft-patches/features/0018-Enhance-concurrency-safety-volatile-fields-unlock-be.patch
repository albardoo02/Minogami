From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: albardoo02 <akshs@outlook.jp>
Date: Tue, 20 Oct 2026 16:55:03 +0900
Subject: [PATCH] Enhance concurrency safety: volatile fields,
 unlock-before-execute, UUID bridge, graceful shutdown


diff --git a/world/minogami/bridge/ParallelBridge.java b/world/minogami/bridge/ParallelBridge.java
index a92dc5e816dcd95745a0d505d762978ea1c70bb8..48485897d377c1f4d72fa89382c3da64b3553b45 100644
--- a/world/minogami/bridge/ParallelBridge.java
+++ b/world/minogami/bridge/ParallelBridge.java
@@ -9,13 +9,17 @@ public class ParallelBridge {
     
     public static boolean parallelWorldBridge = false;
     
-    private static final Map<Player, ParallelEntityMoveHandler> parallelEntityMoveHandlerMap = new ConcurrentHashMap<>();
+    private static final Map<java.util.UUID, ParallelEntityMoveHandler> parallelEntityMoveHandlerMap = new ConcurrentHashMap<>();
     
     public static ParallelEntityMoveHandler getParallelEntityMoveHandler(Player player){
-        if(!parallelWorldBridge) return null;
-        return parallelEntityMoveHandlerMap.computeIfAbsent(player, ParallelEntityMoveHandler::new);
+        if(!parallelWorldBridge || player == null) return null;
+        return parallelEntityMoveHandlerMap.computeIfAbsent(player.getUniqueId(), uuid -> new ParallelEntityMoveHandler(player));
     }
     
-    public static void removeParallelEntityMoveHandler(Player player){parallelEntityMoveHandlerMap.remove(player);}
+    public static void removeParallelEntityMoveHandler(Player player){
+        if (player != null) {
+            parallelEntityMoveHandlerMap.remove(player.getUniqueId());
+        }
+    }
     
 }
